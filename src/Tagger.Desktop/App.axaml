<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Tagger.Desktop.Converters"
             x:Class="Tagger.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://tagger/Themes/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:ArtworkConverter x:Key="ArtworkConverter" />
      <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://tagger/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
