<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tagger.Desktop.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        Icon="/Assets/tagger.png"
        x:Class="Tagger.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="tagger — music tag editor"
        Width="1600"
        Height="980"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFolderCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding AddFilesCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="64,*,30">
    <!-- ============================ top bar ============================ -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="240,Auto,*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
            <ContentControl Theme="{StaticResource MusicNoteIconTheme}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            Width="15"
                            Height="15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="tagger" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
            <TextBlock Text="BETA" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="tool" Theme="{StaticResource ToolButtonTheme}" Command="{Binding AddFolderCommand}" ToolTip.Tip="Add a folder (Ctrl+O)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="M3,6 H9 L11,8 H20 V19 H4 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
              <TextBlock Text="Add folder" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Theme="{StaticResource ToolButtonTheme}" Command="{Binding AddFilesCommand}" ToolTip.Tip="Add individual files (Ctrl+Shift+O)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="M6,2 H15 L20,7 V22 H6 Z M14,3 V8 H19" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
              <TextBlock Text="Add files" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Theme="{StaticResource PrimaryButtonTheme}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" ToolTip.Tip="Preview and save changes (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="M5,3 H17 L21,7 V21 H3 V3 Z M7,3 V10 H17 V3 M7,14 H17 V20 H7 Z" Fill="{DynamicResource OnAccentBrush}" Width="13" Height="13" Stretch="Uniform" />
              <TextBlock Text="Preview &amp; save" Foreground="{DynamicResource OnAccentBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBox x:Name="SearchBox"
                 Grid.Column="2"
                 Width="320"
                 HorizontalAlignment="Right"
                 Margin="24,0"
                 VerticalAlignment="Center"
                 Text="{Binding SearchText}"
                 PlaceholderText="Search title, artist, album…  (artist:aurora)" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="icon" Theme="{StaticResource IconButtonTheme}" Command="{Binding UndoCommand}" ToolTip.Tip="Undo last change (Ctrl+Z)">
            <Path Data="M9,7 H4 V2 M4,7 A9,9 0 1 1 5,18" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" />
          </Button>
          <Button Classes="icon" Theme="{StaticResource IconButtonTheme}" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle theme">
            <TextBlock Text="◐" FontSize="18" />
          </Button>
          <Button Classes="icon" Theme="{StaticResource IconButtonTheme}" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
            <Path Data="M12,15.5 A3.5,3.5 0 1 0 12,8.5 A3.5,3.5 0 1 0 12,15.5 Z M19.4,15 a1.65,1.65 0 0 0 .33,1.82 l.06,.06 a2,2 0 0 1 0,2.83 2,2 0 0 1 -2.83,0 l-.06,-.06 a1.65,1.65 0 0 0 -1.82,-.33 1.65,1.65 0 0 0 -1,1.51 V21 a2,2 0 0 1 -4,0 v-.09 a1.65,1.65 0 0 0 -1,-1.51 1.65,1.65 0 0 0 -1.82,.33 l-.06,.06 a2,2 0 0 1 -2.83,0 2,2 0 0 1 0,-2.83 l.06,-.06 a1.65,1.65 0 0 0 .33,-1.82 1.65,1.65 0 0 0 -1.51,-1 H3 a2,2 0 0 1 0,-4 h.09 a1.65,1.65 0 0 0 1.51,-1 1.65,1.65 0 0 0 -.33,-1.82 l-.06,-.06 a2,2 0 0 1 0,-2.83 2,2 0 0 1 2.83,0 l.06,.06 a1.65,1.65 0 0 0 1.82,.33 H9 a1.65,1.65 0 0 0 1,-1.51 V3 a2,2 0 0 1 4,0 v.09 a1.65,1.65 0 0 0 1,1.51 1.65,1.65 0 0 0 1.82,-.33 l.06,-.06 a2,2 0 0 1 2.83,0 2,2 0 0 1 0,2.83 l-.06,.06 a1.65,1.65 0 0 0 -.33,1.82 V9 a1.65,1.65 0 0 0 1.51,1 H21 a2,2 0 0 1 0,4 h-.09 a1.65,1.65 0 0 0 -1.51,1 Z"
                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent" Width="17" Height="17" Stretch="Uniform" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ workspace ============================ -->
    <Grid Grid.Row="1" ColumnDefinitions="224,*,372" Margin="12">

      <!-- sidebar -->
      <Border Grid.Column="0"
              Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="10">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="LIBRARY" Classes="section" Margin="10,10,10,6" />
            <Button Classes="nav active" Theme="{StaticResource NavButtonTheme}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Data="M4,5 H20 M4,12 H20 M4,19 H20" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                  <TextBlock Text="All tracks" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" Padding="6,1">
                  <TextBlock Text="{Binding TrackCount}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                </Border>
              </Grid>
            </Button>
            <Button Classes="nav" Theme="{StaticResource NavButtonTheme}" Command="{Binding FindDuplicatesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M8,4 H17 V13 H8 Z M4,8 H13 V17 H4 Z" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                <TextBlock Text="Find duplicates" />
              </StackPanel>
            </Button>

            <TextBlock Text="TOOLS" Classes="section" Margin="10,22,10,6" />
            <Button Classes="nav" Theme="{StaticResource NavButtonTheme}" Command="{Binding RenameCommand}" IsEnabled="{Binding HasSelection}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M4,20 L4,16 L15,5 L19,9 L8,20 Z M13,7 L17,11" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                <TextBlock Text="Rename files" />
              </StackPanel>
            </Button>
            <Button Classes="nav" Theme="{StaticResource NavButtonTheme}" Command="{Binding ImportTagsCommand}" IsEnabled="{Binding HasSelection}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M4,5 H20 M4,12 H14 M4,19 H20 M17,10 L20,13 L17,16" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                <TextBlock Text="Tags from filename" />
              </StackPanel>
            </Button>
            <Button Classes="nav" Theme="{StaticResource NavButtonTheme}" Command="{Binding OpenSettingsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M12,15.5 A3.5,3.5 0 1 0 12,8.5 A3.5,3.5 0 1 0 12,15.5 Z M19.4,15 a1.65,1.65 0 0 0 .33,1.82 l.06,.06 a2,2 0 0 1 0,2.83 2,2 0 0 1 -2.83,0 l-.06,-.06 a1.65,1.65 0 0 0 -1.82,-.33 1.65,1.65 0 0 0 -1,1.51 V21 a2,2 0 0 1 -4,0 v-.09 a1.65,1.65 0 0 0 -1,-1.51 1.65,1.65 0 0 0 -1.82,.33 l-.06,.06 a2,2 0 0 1 -2.83,0 2,2 0 0 1 0,-2.83 l.06,-.06 a1.65,1.65 0 0 0 .33,-1.82 1.65,1.65 0 0 0 -1.51,-1 H3 a2,2 0 0 1 0,-4 h.09 a1.65,1.65 0 0 0 1.51,-1 1.65,1.65 0 0 0 -.33,-1.82 l-.06,-.06 a2,2 0 0 1 0,-2.83 2,2 0 0 1 2.83,0 l.06,.06 a1.65,1.65 0 0 0 1.82,.33 H9 a1.65,1.65 0 0 0 1,-1.51 V3 a2,2 0 0 1 4,0 v.09 a1.65,1.65 0 0 0 1,1.51 1.65,1.65 0 0 0 1.82,-.33 l.06,-.06 a2,2 0 0 1 2.83,0 2,2 0 0 1 0,2.83 l-.06,.06 a1.65,1.65 0 0 0 -.33,1.82 V9 a1.65,1.65 0 0 0 1.51,1 H21 a2,2 0 0 1 0,4 h-.09 a1.65,1.65 0 0 0 -1.51,1 Z"
                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="8" Margin="6,16,6,4">
            <TextBlock Text="OPEN FOLDERS" Classes="section" />
            <ItemsControl ItemsSource="{Binding LibraryFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="10"
                          Margin="0,0,0,6"
                          ToolTip.Tip="{Binding}">
                    <TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" MaxLines="2" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border IsVisible="{Binding !HasLibraryFolders}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
              <TextBlock Text="No folder open" Classes="muted" />
            </Border>
            <TextBlock Text="tagger 0.1.0 · .NET 11 · Avalonia 12" Classes="muted" FontSize="10" Margin="2,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- library -->
      <Border Grid.Column="1" Classes="card" Margin="12,0" ClipToBounds="True">
        <Grid RowDefinitions="74,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,0,16,0">
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Library" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Classes="badge"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding LibraryTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="M3,6 H9 L11,8 H20 V19 H4 Z"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.4"
                          Fill="Transparent"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LibraryRoot}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               MaxWidth="260"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding CollectionSummary}" Classes="muted" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Classes="icon" Theme="{StaticResource IconButtonTheme}" Command="{Binding ExpandAllCommand}" ToolTip.Tip="Expand every folder">
                <TextBlock Text="⊞" FontSize="16" />
              </Button>
              <Button Classes="icon" Theme="{StaticResource IconButtonTheme}" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse every folder">
                <TextBlock Text="⊟" FontSize="16" />
              </Button>
              <Button Classes="tool" Theme="{StaticResource ToolButtonTheme}" ToolTip.Tip="Choose how tracks are sorted">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Name" Command="{Binding SortCommand}" CommandParameter="FileName" />
                    <MenuItem Header="Title" Command="{Binding SortCommand}" CommandParameter="Title" />
                    <MenuItem Header="Artist" Command="{Binding SortCommand}" CommandParameter="Artist" />
                    <MenuItem Header="Album" Command="{Binding SortCommand}" CommandParameter="Album" />
                    <MenuItem Header="Year" Command="{Binding SortCommand}" CommandParameter="Year" />
                    <MenuItem Header="Genre" Command="{Binding SortCommand}" CommandParameter="Genre" />
                    <MenuItem Header="Duration" Command="{Binding SortCommand}" CommandParameter="Duration" />
                    <MenuItem Header="Format" Command="{Binding SortCommand}" CommandParameter="Format" />
                    <MenuItem Header="Quality" Command="{Binding SortCommand}" CommandParameter="Bitrate" />
                  </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="Sort:" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SortSummary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="icon" Theme="{StaticResource IconButtonTheme}" Command="{Binding ToggleSortDirectionCommand}" ToolTip.Tip="Reverse sort direction">
                <TextBlock Text="↕" FontSize="15" />
              </Button>
              <Button Classes="tool" Theme="{StaticResource ToolButtonTheme}" Command="{Binding ClearLibraryCommand}" ToolTip.Tip="Unload all files (does not delete them)">
                <TextBlock Text="Clear" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" IsVisible="{Binding HasTracks}">
            <TreeView x:Name="TrackTree"
                      Classes="libraryTree"
                      ItemsSource="{Binding VisibleTree}"
                      SelectionMode="Multiple"
                      Padding="6,2,6,8"
                      ItemContainerTheme="{StaticResource LibraryTreeItemTheme}"
                      SelectionChanged="OnTrackSelectionChanged">
              <TreeView.KeyBindings>
                <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectionCommand}" />
                <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
              </TreeView.KeyBindings>
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:FolderNodeViewModel"
                                  x:DataType="vm:FolderNodeViewModel"
                                  ItemsSource="{Binding Children}">
                  <Grid ColumnDefinitions="*,Auto"
                        Height="34"
                        Margin="4,0,10,0"
                        AutomationProperties.Name="{Binding Name}"
                        ToolTip.Tip="{Binding Path}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="M3,6 H9 L11,8 H20 V19 H4 Z"
                            Stroke="{DynamicResource AccentBrush}"
                            StrokeThickness="1.4"
                            Fill="Transparent"
                            Width="14"
                            Height="14"
                            Stretch="Uniform"
                            VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Classes="badge" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TrackCountText}" FontSize="9" Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DurationText}"
                               FontSize="10"
                               Classes="muted"
                               VerticalAlignment="Center" />
                  </Grid>
                </TreeDataTemplate>

                <DataTemplate DataType="vm:TrackRowViewModel" x:DataType="vm:TrackRowViewModel">
                  <Grid ColumnDefinitions="*,Auto"
                        Height="44"
                        Margin="4,0,10,0"
                        AutomationProperties.Name="{Binding Title}"
                        ToolTip.Tip="{Binding FilePath}">
                    <StackPanel VerticalAlignment="Center" Spacing="1" Margin="0,0,16,0">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DetailLine}" FontSize="10" Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Duration}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                      <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Format}" FontSize="9" FontWeight="Bold" Classes="secondary" />
                      </Border>
                      <TextBlock Text="{Binding Bitrate}"
                                 FontSize="10"
                                 Classes="muted"
                                 Width="58"
                                 TextAlignment="Right"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>

          <!-- empty state -->
          <StackPanel Grid.Row="1"
                      IsVisible="{Binding IsEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12"
                      MaxWidth="380">
            <Border Width="70" Height="70" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
              <ContentControl Theme="{StaticResource MusicNoteIconTheme}"
                              Width="30"
                              Height="30"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Your library is waiting" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Open a folder of music to read, edit, and organize tags. Files are never deleted."
                       Classes="muted"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
              <Button Classes="primary" Theme="{StaticResource PrimaryButtonTheme}" Content="Add folder" Command="{Binding AddFolderCommand}" />
              <Button Classes="tool" Theme="{StaticResource ToolButtonTheme}" Content="Add files" Command="{Binding AddFilesCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- busy overlay -->
          <Border Grid.Row="1"
                  IsVisible="{Binding IsBusy}"
                  Background="{DynamicResource OverlayBrush}">
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding BusyText}" FontSize="13" FontWeight="SemiBold" />
                <ProgressBar Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                <TextBlock Text="Reading metadata and artwork. Large libraries can take a moment." Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </Border>

      <!-- inspector -->
      <Border Grid.Column="2" Classes="card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Margin="18,18,18,12" Spacing="4">
            <TextBlock Text="INSPECTOR" Classes="section" />
            <TextBlock Text="{Binding SelectionSummary}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding SelectionCount, StringFormat='{}{0} selected'}" Classes="muted" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSelection}" Padding="18,0,14,18">
            <StackPanel Spacing="16">
              <Border CornerRadius="12"
                      ClipToBounds="True"
                      Background="{DynamicResource SurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto">
                  <Grid x:Name="ArtworkViewport"
                        Height="{Binding #ArtworkViewport.Bounds.Width}"
                        ClipToBounds="True"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Panel IsVisible="{Binding Editor.ArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNull}}">
                      <Panel Width="196"
                             Height="196"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Ellipse Width="196"
                                 Height="196"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="1"
                                 Opacity="0.18" />
                        <Ellipse Width="160"
                                 Height="160"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="1"
                                 Opacity="0.28" />
                        <Ellipse Width="124"
                                 Height="124"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="1"
                                 Opacity="0.38" />
                        <Ellipse Width="88"
                                 Height="88"
                                 Fill="{DynamicResource SurfaceRaisedBrush}"
                                 Stroke="{DynamicResource BorderStrongBrush}"
                                 StrokeThickness="1" />
                        <ContentControl Theme="{StaticResource MusicNoteIconTheme}"
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                      </Panel>
                      <TextBlock Text="Add cover art"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20" />
                    </Panel>
                    <Image Source="{Binding Editor.ArtworkBytes, Converter={StaticResource ArtworkConverter}}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                  </Grid>
                  <Border Grid.Row="1"
                          Background="{DynamicResource SurfaceRaisedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="0,1,0,0"
                          Padding="9,8">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Text="{Binding Editor.ArtworkSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="tool" Theme="{StaticResource ToolButtonTheme}" Content="Choose" Command="{Binding Editor.PickArtworkCommand}" Margin="0,0,5,0" Padding="8,4" FontSize="11" />
                      <Button Grid.Column="2" Classes="tool" Theme="{StaticResource ToolButtonTheme}" Content="Remove" Command="{Binding Editor.ClearArtworkCommand}" Padding="8,4" FontSize="11" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="Mixed artwork across the selection." Classes="muted" IsVisible="{Binding Editor.IsArtworkMixed}" />

              <StackPanel Spacing="4">
                <TextBlock Text="BASIC" Classes="section" />
                <ItemsControl ItemsSource="{Binding Editor.BasicFields}" ItemTemplate="{StaticResource FieldTemplate}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="RELEASE" Classes="section" />
                <ItemsControl ItemsSource="{Binding Editor.ReleaseFields}" ItemTemplate="{StaticResource FieldTemplate}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="CREDITS" Classes="section" />
                <ItemsControl ItemsSource="{Binding Editor.CreditsFields}" ItemTemplate="{StaticResource FieldTemplate}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="ADVANCED" Classes="section" />
                <ItemsControl ItemsSource="{Binding Editor.AdvancedFields}" ItemTemplate="{StaticResource FieldTemplate}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1"
                      IsVisible="{Binding !HasSelection}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      MaxWidth="260">
            <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource SurfaceRaisedBrush}" HorizontalAlignment="Center">
              <Path Data="M4,20 L4,16 L15,5 L19,9 L8,20 Z M13,7 L17,11"
                    Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" Fill="Transparent"
                    Width="24" Height="24" Stretch="Uniform" />
            </Border>
            <TextBlock Text="Nothing selected" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Select one or more tracks to edit their tags. Mixed values are preserved until you change them."
                       Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="2"
                  IsVisible="{Binding HasSelection}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Button Classes="tool" Theme="{StaticResource ToolButtonTheme}" Content="Reset" Command="{Binding Editor.ResetEditsCommand}" />
              <Button Grid.Column="1"
                      Classes="primary" Theme="{StaticResource PrimaryButtonTheme}"
                      Content="Preview &amp; save"
                      Command="{Binding SaveCommand}"
                      IsEnabled="{Binding CanSave}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================ status bar ============================ -->
    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="11" Classes="secondary" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding CollectionSummary}" FontSize="11" Classes="muted" Margin="16,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Editor.StatusMessage}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>

  <Window.Resources>
    <DataTemplate x:Key="FieldTemplate" x:DataType="vm:TagFieldEditorViewModel">
      <StackPanel Spacing="4" Margin="0,5,0,7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Classes="secondary" />
          <Border Grid.Column="1" Classes="badge" Padding="5,1" IsVisible="{Binding IsMixed}">
            <TextBlock Text="MIXED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </Grid>
        <TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding PlaceholderText}" />
        <TextBlock Text="{Binding Error}"
                   FontSize="10"
                   Foreground="{DynamicResource DangerBrush}"
                   IsVisible="{Binding Error, Converter={StaticResource StringNotEmpty}}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
</Window>
